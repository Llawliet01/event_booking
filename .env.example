# Postgres
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Connection pool (keep small for free-tier / PgBouncer-fronted Postgres)
POOL_MIN=1
POOL_MAX=10

# Booking behaviour
HOLD_DURATION_MINUTES=5
BOOKING_STRATEGY=A

# Webhook
WEBHOOK_HMAC_SECRET=change-me-too

# Idempotency
IDEMPOTENCY_IN_PROGRESS_TIMEOUT_SECONDS=30

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Misc
PORT=8000
ENV=development
AUTH_RATE_LIMIT_PER_MINUTE=5

# scripts/seed.py
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo12345
